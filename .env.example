# ============================================================
# Base de Datos
# ============================================================
# IMPORTANTE (RNF-04): la app se conecta con app_agente, un rol SIN superusuario
# y SIN BYPASSRLS. Las politicas de Row-Level Security NO aplican a un rol
# superusuario: usar el rol administrador aqui deja el aislamiento multi-tenant
# inerte, sin ningun error visible. El rol lo crea la migracion 0002.
DATABASE_URL=postgresql+asyncpg://app_agente:app_password_dev@localhost:5432/agente_soporte_mvp
DATABASE_POOL_SIZE=10
DATABASE_MAX_OVERFLOW=20

# Contrasena del rol de aplicacion. La lee la migracion 0002 al crear el rol.
# Debe coincidir con la de DATABASE_URL. En produccion, gestionarla por secreto.
APP_DB_PASSWORD=app_password_dev

# Credenciales del superusuario: SOLO para correr migraciones (alembic), nunca
# para la app. Alembic necesita crear extensiones y roles.
# ADMIN_DATABASE_URL=postgresql+asyncpg://user:password@localhost:5432/agente_soporte_mvp

# ============================================================
# Anthropic API
# ============================================================
ANTHROPIC_API_KEY=sk-ant-v0-xxxxx

# Modelos (tiering)
ANTHROPIC_MODEL_CLASSIFY=claude-haiku-4-5
ANTHROPIC_MODEL_RESPOND=claude-sonnet-5-5

# ============================================================
# WhatsApp Cloud API (Meta for Developers)
# ============================================================
# Phone Number ID: identificador único del número de WhatsApp registrado
# Se obtiene de: Meta for Developers → WhatsApp → API Setup
WHATSAPP_PHONE_NUMBER_ID=your_phone_number_id_here

# WhatsApp Business Account ID (WABA): identifica la cuenta de negocio completa
# Se obtiene de: Meta for Developers → WhatsApp → API Setup
WHATSAPP_WABA_ID=your_waba_id_here

# Access Token permanente: token de System User para hacer llamadas salientes
# Se obtiene de: Meta Business Suite → Business Settings → System Users
# IMPORTANTE: guardar en .env local, NUNCA en el repo
WHATSAPP_ACCESS_TOKEN=your_permanent_access_token_here

# App Secret: para verificar la firma HMAC del webhook entrante (X-Hub-Signature-256)
# Se obtiene de: Meta for Developers → App Dashboard → Settings → Basic
WHATSAPP_APP_SECRET=your_app_secret_here

# Verify Token: string arbitrario que inventás vos
# Lo usás para verificar la URL del webhook en la configuración de Meta
# Debe coincidir con lo que configuraste en Meta for Developers → Webhook Configuration
WHATSAPP_VERIFY_TOKEN=your_arbitrary_verify_token_here

# ============================================================
# FastAPI / Aplicación
# ============================================================
ENV=development
DEBUG=True
LOG_LEVEL=INFO

# URL pública de la aplicación (para el webhook callback)
# En producción: https://tu-dominio.com
# En desarrollo local con ngrok: https://xxxxx.ngrok.io
API_BASE_URL=https://localhost:8000

# ============================================================
# Panel de administración (Streamlit)
# ============================================================
# Dónde encuentra el panel a la API. El panel corre como proceso aparte y solo
# habla por HTTP: no lee el resto de este archivo ni toca la base de datos.
PANEL_API_URL=http://localhost:8000

# ============================================================
# AWS: aviso al asesor por correo (Amazon SES)
# ============================================================
# Remitente verificado en SES. Vacío = no se envían correos (el aviso queda
# solo en el panel). Las credenciales NO van aquí: en AWS las da el rol de la
# EC2; en local, el perfil de la AWS CLI.
AWS_REGION=us-east-1
SES_SENDER=

# ============================================================
# Configuración general
# ============================================================
TIMEZONE=America/Bogota
LANGUAGE=es

# Observabilidad (Fase 7)
SENTRY_DSN=
ENABLE_METRICS=False
