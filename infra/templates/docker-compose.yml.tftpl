# Generado por Terraform (infra/templates/docker-compose.yml.tftpl). No editar en el servidor.
# Las variables $${...} las resuelve Docker Compose desde /opt/annie/.env (armado desde SSM).

services:
  db:
    image: pgvector/pgvector:pg16
    restart: unless-stopped
    environment:
      POSTGRES_USER: annie_admin
      POSTGRES_PASSWORD: $${POSTGRES_PASSWORD}
      POSTGRES_DB: annie
    volumes:
      - pgdata:/var/lib/postgresql/data
    healthcheck:
      test: ["CMD-SHELL", "pg_isready -U annie_admin -d annie"]
      interval: 5s
      timeout: 5s
      retries: 20

  # Corre las migraciones con el usuario administrador y termina.
  # La API arranca solo si esto salió bien.
  migrate:
    image: ${api_image}
    restart: "no"
    env_file: .env
    environment:
      # ENV=production es OBLIGATORIO aquí: la migración 0004 crea un rol de
      # pruebas con BYPASSRLS (se salta el aislamiento entre negocios) salvo
      # que ENV sea "production".
      ENV: production
      DATABASE_URL: postgresql+asyncpg://app_agente:$${APP_DB_PASSWORD}@db:5432/annie
      ADMIN_DATABASE_URL: postgresql+asyncpg://annie_admin:$${POSTGRES_PASSWORD}@db:5432/annie
    command: ["alembic", "upgrade", "head"]
    depends_on:
      db:
        condition: service_healthy

  # La API se conecta con app_agente (sin superusuario ni BYPASSRLS), así RLS aplica.
  api:
    image: ${api_image}
    restart: unless-stopped
    env_file: .env
    environment:
      DATABASE_URL: postgresql+asyncpg://app_agente:$${APP_DB_PASSWORD}@db:5432/annie
      ENV: production
      DEBUG: "false"
      API_BASE_URL: https://${domain}
      AWS_REGION: ${region}
      AWS_DEFAULT_REGION: ${region}
      MEDIA_BUCKET: ${media_bucket}
      SES_SENDER: ${ses_sender}
    depends_on:
      migrate:
        condition: service_completed_successfully

  panel:
    image: ${panel_image}
    restart: unless-stopped
    environment:
      PANEL_API_URL: http://api:8000
    depends_on:
      - api

  caddy:
    image: caddy:2
    restart: unless-stopped
    ports:
      - "80:80"
      - "443:443"
    volumes:
      - ./Caddyfile:/etc/caddy/Caddyfile:ro
      - caddy_data:/data
      - caddy_config:/config
    depends_on:
      - api
      - panel

volumes:
  pgdata:
  caddy_data:
  caddy_config:
